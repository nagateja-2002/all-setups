#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run this legacy setup script as root or through an approved privilege-escalation method." >&2
  exit 1
fi

apt update -y
apt install -y openjdk-11-jre-headless wget
wget https://dlcdn.apache.org/tomcat/tomcat-9/v9.0.115/bin/apache-tomcat-9.0.115.tar.gz
tar -xzf apache-tomcat-9.0.115.tar.gz

# No Manager account or password is created by this script.
# Keep Tomcat's default manager context restrictions in place (localhost-only).
# Configure any required admin user through approved secret management and
# keep the Manager endpoint private rather than committing credentials.

sh apache-tomcat-9.0.115/bin/startup.sh
